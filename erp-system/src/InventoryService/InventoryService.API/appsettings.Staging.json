{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=inventory-service-staging.database.windows.net;Database=InventoryServiceDb_Staging;User Id=${DB_USER};Password=${DB_PASSWORD};Encrypt=true;TrustServerCertificate=false;"
  },
  "Jwt": {
    "Key": "${JWT_SECRET_STAGING}",
    "Issuer": "https://api-staging.ocelon.com",
    "Audience": "erp-system-staging",
    "ExpirationMinutes": 30
  },
  "ApplicationInsights": {
    "ConnectionString": "${APPINSIGHTS_CONNECTION_STRING_STAGING}"
  },
  "Azure": {
    "ServiceBus": {
      "ConnectionString": "${SERVICEBUS_CONNECTION_STRING_STAGING}"
    },
    "KeyVault": {
      "VaultUrl": "https://erp-keyvault-staging.vault.azure.net/"
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeoutSeconds": 30,
    "EndpointPath": "/health"
  },
  "Swagger": {
    "Enabled": true,
    "Title": "Inventory Service API - Staging",
    "Version": "v1"
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "Window": "00:01:00"
  },
  "Caching": {
    "Redis": {
      "ConnectionString": "${REDIS_CONNECTION_STRING_STAGING}"
    },
    "DefaultExpirationMinutes": 15
  },
  "AllowedHosts": "*"
}
