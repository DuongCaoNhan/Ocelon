{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AccountingServiceDb_Dev;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true;"
  },
  "Jwt": {
    "Key": "dev-accounting-secret-key-for-development-only-256-bits",
    "Issuer": "http://localhost:5003",
    "Audience": "erp-system-dev",
    "ExpirationMinutes": 60
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Azure": {
    "ServiceBus": {
      "ConnectionString": ""
    },
    "KeyVault": {
      "VaultUrl": ""
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeoutSeconds": 60,
    "EndpointPath": "/health"
  },
  "Swagger": {
    "Enabled": true,
    "Title": "Accounting Service API - Development",
    "Version": "v1",
    "IncludeXmlComments": true
  },
  "RateLimiting": {
    "Enabled": false
  },
  "Caching": {
    "InMemory": true,
    "DefaultExpirationMinutes": 5
  },
  "DatabaseOptions": {
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true
  },
  "AllowedHosts": "*"
}
