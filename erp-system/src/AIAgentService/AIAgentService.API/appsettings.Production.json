{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "api.ocelon.com;*.ocelon.com",
  "ConnectionStrings": {
    "DefaultConnection": "Server=aiagent-service-prod.database.windows.net;Database=AIAgentDB_Production;User Id=${DB_USER};Password=${DB_PASSWORD};Encrypt=true;TrustServerCertificate=false;",
    "Redis": "${REDIS_CONNECTION_STRING_PRODUCTION}"
  },
  "AzureOpenAI": {
    "Endpoint": "${AZURE_OPENAI_ENDPOINT_PRODUCTION}",
    "DeploymentName": "${AZURE_OPENAI_DEPLOYMENT_PRODUCTION}",
    "ApiKey": "${AZURE_OPENAI_KEY_PRODUCTION}"
  },
  "Services": {
    "HRService": {
      "BaseUrl": "https://hr-service.ocelon.com"
    },
    "InventoryService": {
      "BaseUrl": "https://inventory-service.ocelon.com"
    },
    "AccountingService": {
      "BaseUrl": "https://accounting-service.ocelon.com"
    },
    "WorkflowService": {
      "BaseUrl": "https://workflow-service.ocelon.com"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": "${APPINSIGHTS_CONNECTION_STRING_PRODUCTION}"
  },
  "Azure": {
    "ServiceBus": {
      "ConnectionString": "${SERVICEBUS_CONNECTION_STRING_PRODUCTION}"
    },
    "KeyVault": {
      "VaultUrl": "https://erp-keyvault-prod.vault.azure.net/"
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeoutSeconds": 30,
    "EndpointPath": "/health"
  },
  "Swagger": {
    "Enabled": false
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 20,
    "Window": "00:01:00"
  },
  "AI": {
    "MaxTokens": 2000,
    "Temperature": 0.3,
    "TimeoutSeconds": 60
  },
  "Security": {
    "EnableDetailedErrors": false,
    "RequireHttps": true,
    "EnableSecurityHeaders": true
  }
}
