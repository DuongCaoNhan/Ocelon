{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=aiagent-service-staging.database.windows.net;Database=AIAgentDB_Staging;User Id=${DB_USER};Password=${DB_PASSWORD};Encrypt=true;TrustServerCertificate=false;",
    "Redis": "${REDIS_CONNECTION_STRING_STAGING}"
  },
  "AzureOpenAI": {
    "Endpoint": "${AZURE_OPENAI_ENDPOINT_STAGING}",
    "DeploymentName": "${AZURE_OPENAI_DEPLOYMENT_STAGING}",
    "ApiKey": "${AZURE_OPENAI_KEY_STAGING}"
  },
  "Services": {
    "HRService": {
      "BaseUrl": "https://hr-service-staging.ocelon.com"
    },
    "InventoryService": {
      "BaseUrl": "https://inventory-service-staging.ocelon.com"
    },
    "AccountingService": {
      "BaseUrl": "https://accounting-service-staging.ocelon.com"
    },
    "WorkflowService": {
      "BaseUrl": "https://workflow-service-staging.ocelon.com"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": "${APPINSIGHTS_CONNECTION_STRING_STAGING}"
  },
  "Azure": {
    "ServiceBus": {
      "ConnectionString": "${SERVICEBUS_CONNECTION_STRING_STAGING}"
    },
    "KeyVault": {
      "VaultUrl": "https://erp-keyvault-staging.vault.azure.net/"
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeoutSeconds": 30,
    "EndpointPath": "/health"
  },
  "Swagger": {
    "Enabled": true,
    "Title": "AI Agent Service API - Staging",
    "Version": "v1"
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 50,
    "Window": "00:01:00"
  },
  "AI": {
    "MaxTokens": 4000,
    "Temperature": 0.7,
    "TimeoutSeconds": 30
  }
}
