{
  "ConnectionStrings": {
    "AuditDatabase": "Server=audit-service-prod.database.windows.net;Database=ERPAuditDb_Production;User Id=${DB_USER};Password=${DB_PASSWORD};Encrypt=true;TrustServerCertificate=false;",
    "ApplicationInsights": "${APPINSIGHTS_CONNECTION_STRING_PRODUCTION}"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "${AZURE_AD_DOMAIN}",
    "TenantId": "${AZURE_AD_TENANT_ID}",
    "ClientId": "${AZURE_AD_CLIENT_ID_PRODUCTION}",
    "Audience": "api://${AZURE_AD_CLIENT_ID_PRODUCTION}"
  },
  "AzureServiceBus": {
    "Namespace": "${SERVICEBUS_NAMESPACE_PRODUCTION}",
    "AuditQueue": "audit-events"
  },
  "AllowedOrigins": [
    "https://api.ocelon.com",
    "https://ocelon.com",
    "https://www.ocelon.com"
  ],
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.ApplicationInsights" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "${APPINSIGHTS_CONNECTION_STRING_PRODUCTION}",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      }
    ]
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeoutSeconds": 30,
    "EndpointPath": "/health"
  },
  "Swagger": {
    "Enabled": false
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "Window": "00:01:00"
  },
  "Security": {
    "EnableDetailedErrors": false,
    "RequireHttps": true,
    "EnableSecurityHeaders": true
  },
  "AllowedHosts": "api.ocelon.com;*.ocelon.com"
}
