{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=hr-service-prod.database.windows.net;Database=HRServiceDb_Production;User Id=${DB_USER};Password=${DB_PASSWORD};Encrypt=true;TrustServerCertificate=false;"
  },
  "Jwt": {
    "Key": "${JWT_SECRET_PRODUCTION}",
    "Issuer": "https://api.ocelon.com",
    "Audience": "erp-system",
    "ExpirationMinutes": 15
  },
  "ApplicationInsights": {
    "ConnectionString": "${APPINSIGHTS_CONNECTION_STRING_PRODUCTION}"
  },
  "Azure": {
    "ServiceBus": {
      "ConnectionString": "${SERVICEBUS_CONNECTION_STRING_PRODUCTION}"
    },
    "KeyVault": {
      "VaultUrl": "https://erp-keyvault-prod.vault.azure.net/"
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeoutSeconds": 30,
    "EndpointPath": "/health"
  },
  "Swagger": {
    "Enabled": false
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 50,
    "Window": "00:01:00"
  },
  "Caching": {
    "Redis": {
      "ConnectionString": "${REDIS_CONNECTION_STRING_PRODUCTION}"
    },
    "DefaultExpirationMinutes": 30
  },
  "Security": {
    "EnableDetailedErrors": false,
    "RequireHttps": true,
    "EnableSecurityHeaders": true
  },
  "AllowedHosts": "api.ocelon.com;*.ocelon.com"
}
