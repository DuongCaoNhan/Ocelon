{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=hr-service-prod.database.windows.net;Database=HRServiceDb_Production;Authentication=Active Directory Managed Identity;Encrypt=true;TrustServerCertificate=false;",
    "Redis": "hr-redis-prod.redis.cache.windows.net:6380,ssl=True,abortConnect=False"
  },
  "Jwt": {
    "Issuer": "https://api.ocelon.com",
    "Audience": "erp-system",
    "ExpirationMinutes": 15
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Azure": {
    "ServiceBus": {
      "ConnectionString": ""
    },
    "KeyVault": {
      "VaultUrl": "https://erp-keyvault-prod.vault.azure.net/"
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeoutSeconds": 30,
    "EndpointPath": "/health"
  },
  "Swagger": {
    "Enabled": false
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 50,
    "Window": "00:01:00"
  },
  "Caching": {
    "Redis": {
      "ConnectionString": ""
    },
    "DefaultExpirationMinutes": 30
  },
  "Security": {
    "EnableDetailedErrors": false,
    "RequireHttps": true,
    "EnableSecurityHeaders": true
  },
  "AllowedHosts": "api.ocelon.com;*.ocelon.com"
}
