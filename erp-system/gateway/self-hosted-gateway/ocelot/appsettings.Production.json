{
  "Environment": "Production",
  "BaseUrl": "https://api.ocelon.com",
  "EnableDetailedErrors": false,
  "EnableSwagger": false,
  "Logging": {
    "EnableRequestLogging": false,
    "EnableResponseLogging": false,
    "EnablePerformanceLogging": true,
    "LogLevel": "Warning"
  },
  "Security": {
    "EnableCors": true,
    "AllowedOrigins": [
      "https://ocelon.com",
      "https://www.ocelon.com",
      "https://admin.ocelon.com"
    ],
    "RequireHttps": true,
    "EnableSecurityHeaders": true
  }
}
