{
  "Environment": "Staging",
  "BaseUrl": "https://api-staging.ocelon.com",
  "EnableDetailedErrors": false,
  "EnableSwagger": true,
  "Logging": {
    "EnableRequestLogging": true,
    "EnableResponseLogging": false,
    "EnablePerformanceLogging": true,
    "LogLevel": "Information"
  },
  "Security": {
    "EnableCors": true,
    "AllowedOrigins": [
      "https://staging.ocelon.com",
      "https://admin-staging.ocelon.com"
    ],
    "RequireHttps": true,
    "EnableSecurityHeaders": true
  }
}
