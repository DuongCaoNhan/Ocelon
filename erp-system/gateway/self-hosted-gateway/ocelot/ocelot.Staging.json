  "Aggregates": [
    {
      "RouteKeys": [
        "hr-health",
        "inventory-health", 
        "accounting-health",
        "workflow-health",
        "notification-health"
      ],
      "UpstreamPathTemplate": "/health/all",
      "UpstreamHttpMethod": [ "GET" ],
      "Aggregator": "HealthCheckAggregator"
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "hr-service",
      "Config": [
        {
          "Name": "HR Service API (Staging)",
          "Version": "v1",
          "Url": "https://hr-service-staging.ocelon.com/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "inventory-service",
      "Config": [
        {
          "Name": "Inventory Service API (Staging)",
          "Version": "v1",
          "Url": "https://inventory-service-staging.ocelon.com/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "accounting-service",
      "Config": [
        {
          "Name": "Accounting Service API (Staging)",
          "Version": "v1",
          "Url": "https://accounting-service-staging.ocelon.com/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "workflow-service",
      "Config": [
        {
          "Name": "Workflow Service API (Staging)",
          "Version": "v1",
          "Url": "https://workflow-service-staging.ocelon.com/v3/api-docs"
        }
      ]
    },
    {
      "Key": "notification-service",
      "Config": [
        {
          "Name": "Notification Service API (Staging)",
          "Version": "v1",
          "Url": "https://notification-service-staging.ocelon.com/api-docs"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://api-staging.ocelon.com",
    "RateLimitOptions": {
      "QuotaExceededMessage": "API rate limit exceeded for staging environment. Please try again later.",
      "HttpStatusCode": 429,
      "ClientIdHeader": "X-Client-Id",
      "DisableRateLimitHeaders": false
    },
    "QoSOptions": {
      "ExceptionsAllowedBeforeBreaking": 5,
      "DurationOfBreak": 5000,
      "TimeoutValue": 30000
    },
    "LoadBalancerOptions": {
      "Type": "RoundRobin",
      "Key": "RemoteAddress",
      "Expiry": 3600000
    },
    "HttpHandlerOptions": {
      "AllowAutoRedirect": false,
      "UseCookieContainer": false,
      "UseTracing": true,
      "UseProxy": false
    },
    "ServiceDiscoveryProvider": {
      "Type": "Consul",
      "Host": "consul-staging.ocelon.com",
      "Port": 8500,
      "ConfigurationKey": "ocelot-staging"
    },
    "DownstreamHeaderTransform": {
      "X-Environment": "Staging",
      "X-Gateway-Version": "1.0.0-staging",
      "X-Content-Type-Options": "nosniff",
      "X-Frame-Options": "DENY",
      "X-XSS-Protection": "1; mode=block"
    }
  }
}
