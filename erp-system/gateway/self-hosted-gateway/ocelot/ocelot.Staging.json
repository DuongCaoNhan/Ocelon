{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/v1/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "hr-service-staging.ocelon.com",
          "Port": 443
        },
        {
          "Host": "hr-service-staging-backup.ocelon.com",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/v1/hr/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS" ],
      "SwaggerKey": "hr-service",
      "Key": "hr-service",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": ["hr.read", "hr.write"]
      },
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 100
      },
      "AddHeadersToRequest": {
        "X-Gateway-Source": "Ocelot-Gateway-Staging",
        "X-Service-Name": "HR-Service",
        "X-Environment": "Staging",
        "X-Request-ID": "{RequestId}",
        "X-Correlation-ID": "{TraceId}"
      },
      "AddClaimsToRequest": {
        "X-User-Id": "sub",
        "X-User-Email": "email",
        "X-User-Roles": "roles"
      },
      "RouteClaimsRequirement": {
        "roles": "HR.Employee,HR.Manager,Admin"
      },
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 5,
        "DurationOfBreak": 5000,
        "TimeoutValue": 30000,
        "CircuitBreakerName": "hr-service-breaker"
      },
      "FileCacheOptions": {
        "TtlSeconds": 300,
        "Region": "hr-cache-staging"
      }
    },
