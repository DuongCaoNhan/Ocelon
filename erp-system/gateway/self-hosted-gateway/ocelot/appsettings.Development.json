{
  "Environment": "Development",
  "BaseUrl": "http://localhost:5000",
  "EnableDetailedErrors": true,
  "EnableSwagger": true,
  "Logging": {
    "EnableRequestLogging": true,
    "EnableResponseLogging": true,
    "EnablePerformanceLogging": true,
    "LogLevel": "Debug"
  },
  "Security": {
    "EnableCors": true,
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:4200",
      "http://localhost:8080"
    ],
    "RequireHttps": false,
    "EnableSecurityHeaders": false
  }
}
