{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/v1/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "hr-service.ocelon.com",
          "Port": 443
        },
        {
          "Host": "hr-service-backup.ocelon.com",
          "Port": 443
        },
        {
          "Host": "hr-service-dr.ocelon.com",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/v1/hr/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS" ],
      "SwaggerKey": "hr-service",
      "Key": "hr-service",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": ["hr.read", "hr.write", "hr.admin"]
      },
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 50,
        "QuotaExceededMessage": "HR Service rate limit exceeded. Please try again later.",
        "HttpStatusCode": 429
      },
      "AddHeadersToRequest": {
        "X-Gateway-Source": "Ocelot-Gateway-Production",
        "X-Service-Name": "HR-Service",
        "X-Environment": "Production",
        "X-Request-ID": "{RequestId}",
        "X-Correlation-ID": "{TraceId}",
        "X-Client-Version": "{ClientVersion}"
      },
      "AddClaimsToRequest": {
        "X-User-Id": "sub",
        "X-User-Email": "email",
        "X-User-Roles": "roles",
        "X-Tenant-Id": "tenant"
      },
      "RouteClaimsRequirement": {
        "roles": "HR.Employee,HR.Manager,Admin"
      },
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 3,
        "DurationOfBreak": 10000,
        "TimeoutValue": 30000,
        "CircuitBreakerName": "hr-service-breaker"
      },
      "FileCacheOptions": {
        "TtlSeconds": 600,
        "Region": "hr-cache-prod"
      }
    },
